# ==============================
# DRDO AI – Offline Assistant
# Environment Template
# ==============================
# Copy this file to .env for local development.
# Never commit the real .env file.

# ---------- Backend / Database ----------
DATABASE_URL=sqlite:///./drdo_ai.db
FRONTEND_URL=http://127.0.0.1:5173

# Generate a long random value for real deployments.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Ollama ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Primary local LLM
OLLAMA_MODEL=gemma4:26b

# Local embedding model
OLLAMA_MODEL_1=nomic-embed-text:latest

# ---------- Vision ----------
MOONDREAM_MODEL=moondream
MOONDREAM_ENABLED=true
MOONDREAM_TIMEOUT=120

# ---------- OCR ----------
# Leave blank if tesseract is available on PATH.
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ---------- Voice ----------
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# CPU fallback:
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# ---------- Default Administrator ----------
# Used only during local initialization when no administrator exists.
# Never commit the real password.
DEFAULT_ADMIN_EMAIL=admin@example.local
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password

# Optional Windows environment value used by OCR discovery on some systems.
# LOCALAPPDATA=
